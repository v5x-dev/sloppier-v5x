# All VITE_ values are public. Match the backend development deployment.
VITE_CONVEX_URL=https://YOUR-DEV-DEPLOYMENT.convex.cloud
VITE_WORKOS_CLIENT_ID=client_YOUR_TEST_CLIENT
VITE_WORKOS_REDIRECT_URI=http://localhost:3002/callback
