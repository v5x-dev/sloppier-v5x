{
  "expo": {
    "name": "code (by v5x)",
    "slug": "code-v5x",
    "version": "0.0.1",
    "scheme": "code-v5x",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.v5x.code"
    },
    "android": {
      "package": "com.v5x.code"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}