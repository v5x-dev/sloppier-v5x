#!/usr/bin/env python3
"""Build committed V5 sources with the toolchain's native make rules and a PCH compiler wrapper."""
import json
import shutil
import os
import pathlib
import subprocess
import sys
import time

# Phase timing for measurement. Off unless V5X_TIMING_LOG names a file.
TIMING_LOG = os.environ.get('V5X_TIMING_LOG')
def mark(event, **fields):
    if TIMING_LOG:
        with open(TIMING_LOG, 'a') as log:
            log.write(json.dumps({'tool': 'v5x-build', 'event': event, 'at': time.time(), **fields}) + '\n')

mark('build-start')
template = sys.argv[1]
# Sysroot for clang: the ARM C++ library is the gcc one shipped in the image.
# gcc's ARM ABI: short enums and the integer typedef widths the gcc-built PROS libraries use. Clang defaults differ
# (uint32_t is unsigned int, not long), which made calls such as pros::rtos::Task fail to link.
CLANG_TARGET_FLAGS = ['--target=arm-none-eabi', '-fshort-enums', '-nostdinc++', '-isystem', '/usr/lib/arm-none-eabi/include/c++/13.2.1', '-isystem', '/usr/lib/arm-none-eabi/include/c++/13.2.1/arm-none-eabi/thumb/v7-a+simd/hard', '-isystem', '/usr/lib/arm-none-eabi/include/c++/13.2.1/arm-none-eabi', '-isystem', '/usr/lib/arm-none-eabi/include', '-D__CHAR16_TYPE__=short unsigned int', '-D__CHAR32_TYPE__=long unsigned int', '-D__INT16_TYPE__=short int', '-D__INT32_TYPE__=long int', '-D__INT_FAST16_TYPE__=int', '-D__INT_FAST8_TYPE__=int', '-D__INT_LEAST16_TYPE__=short int', '-D__INT_LEAST32_TYPE__=long int', '-D__SIG_ATOMIC_TYPE__=int', '-D__UINT16_TYPE__=short unsigned int', '-D__UINT32_TYPE__=long unsigned int', '-D__UINT_FAST16_TYPE__=unsigned int', '-D__UINT_FAST8_TYPE__=unsigned int', '-D__UINT_LEAST16_TYPE__=short unsigned int', '-D__UINT_LEAST32_TYPE__=long unsigned int', '-D__WINT_TYPE__=unsigned int']
if template not in ('pros', 'ez-template', 'rw', 'vexcode', 'jar'):
    sys.exit('Unknown program template')
# Headers every starter includes before project code. The PCH key covers these fixed library headers
# only, so editing project headers reuses the precompiled header that the Builder checkpoint ships with.
LIBRARY_PCH = {
    'rw': '#include "api.h"\n',
    'pros': '#include "api.h"\n',
    'ez-template': '#define PROS_USE_SIMPLE_NAMES\n#define PROS_USE_LITERALS\n#include "api.h"\n#include "EZ-Template/api.hpp"\n',
}
root = pathlib.Path.cwd()
if template in ('pros', 'ez-template', 'rw'):
    dependencies = pathlib.Path('/opt/v5x/deps')
    manifest = json.loads((dependencies / 'manifest.json').read_text())
    for relative in manifest[template]:
        target = root / relative
        if target.is_symlink() or target.is_file():
            target.unlink()
        elif target.is_dir():
            shutil.rmtree(target)
        target.parent.mkdir(parents=True, exist_ok=True)
        target.symlink_to(dependencies / template / relative)
    compiler = os.environ.get('PROS_CXX', 'arm-none-eabi-g++')
    if os.environ.get('V5X_COMPILER') == 'clang':
        # Clang compiles the program; the link stays with the ARM gcc driver.
        compiler = 'clang++'
        os.environ['V5X_EXTRA_CXX_FLAGS'] = json.dumps(CLANG_TARGET_FLAGS)
    header = 'main.h'
    command = ['make', '-j2', 'CXX=/usr/local/bin/v5x-cxx', 'USE_PCH=0']
else:
    compiler = os.environ.get('VEX_CXX', '/usr/bin/clang')
    header = 'vex.h'
    if not (root / 'makefile').exists() and not (root / 'Makefile').exists():
        # Generic VEXcode projects need the SDK's build rules, absent from their source template.
        shutil.copy('/opt/v5x/vexcode.mk', root / 'Makefile')
    command = ['make', '-j2', 'CXX=/usr/local/bin/v5x-cxx', 'T=/opt/vex/sdk', 'P=program', 'CC=/usr/bin/clang']
os.environ['V5X_REAL_CXX'] = compiler
os.environ['V5X_PCH_HEADER'] = str(root / 'include' / header)
if template in LIBRARY_PCH:
    os.environ['V5X_PCH_SOURCE'] = LIBRARY_PCH[template]
else:
    os.environ.pop('V5X_PCH_SOURCE', None)
mark('make-start')
subprocess.run(command, check=True)
mark('make-end')
