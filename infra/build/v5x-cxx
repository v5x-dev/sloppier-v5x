#!/usr/bin/env python3
"""Generate and reuse a PCH with exactly the translation unit's compiler flags."""
import fcntl
import hashlib
import os
import pathlib
import re
import subprocess
import sys
import json
import time

# Phase timing for measurement. Off unless V5X_TIMING_LOG names a file; when off, behaviour is unchanged.
TIMING_LOG = os.environ.get('V5X_TIMING_LOG')
def mark(event, **fields):
    if TIMING_LOG:
        with open(TIMING_LOG, 'a') as log:
            log.write(json.dumps({'tool': 'v5x-cxx', 'event': event, 'at': time.time(), **fields}) + '\n')

def run_units(source, output, compiler, target_flags, flags, pch, cache_root, pch_prefix):
    """Splits, compiles changed units, and writes the combined object to output. Raises on any fallback case."""
    import unit_build
    # No newline translation: libclang's offsets count the file's bytes, CRLF included.
    text = open(source, encoding='utf-8', newline='').read()
    stem = source.replace('/', '__')
    state_dir = cache_root / 'state'
    state_dir.mkdir(parents=True, exist_ok=True)
    state_file, prev_file = state_dir / f'{stem}.json', state_dir / f'{stem}.src'
    previous, previous_text = None, None
    if state_file.exists() and prev_file.exists():
        try:
            previous = unit_build.Analysis.from_json(state_file.read_text())
            previous_text = open(prev_file, encoding='utf-8', newline='').read()
            if unit_build.sha(previous_text) != previous.source_sha:
                previous, previous_text = None, None
        except Exception:
            previous, previous_text = None, None
    # Header-level state depends only on the headers, so it is checked once per PCH and cached with it.
    import unit_split
    marker = cache_root / 'headers' / (unit_build.sha(pch) + '.json')
    if marker.exists():
        risky = json.loads(marker.read_text())
    else:
        risky = unit_split.header_check(pch_prefix, [*target_flags, *flags, '-x', 'c++'])
        marker.parent.mkdir(parents=True, exist_ok=True)
        marker.write_text(json.dumps(risky))
    # libclang parses with the same PCH the units compile with, which keeps the analysis fast.
    plan = unit_build.plan(source, text, [*target_flags, *flags, '-x', 'c++', '-include-pch', pch], previous_text, previous, risky)
    include_dir = os.path.dirname(source) or '.'
    unit_flags = [*target_flags, *flags]
    compile_key = unit_build.flags_key(unit_flags, include_dir, pch)
    # A unit keeps its object from the last build when nothing it can see has changed, on either path.
    reuse = unit_build.reusable_units(plan, previous, compile_key)
    mark('units-planned', source=source, mode=plan.analysis.mode, units=len(plan.labels), reused=len(reuse))
    objects = unit_build.compile_units(plan, cache_root / 'objects', compiler, unit_flags, pch,
                                       include_dir=include_dir, basename=os.path.basename(source), reuse=reuse)
    unit_build.combine(objects, output)
    plan.analysis.objects = {key: str(path) for key, path in zip(plan.keys, objects)}
    plan.analysis.flags = compile_key
    with open(prev_file, 'w', encoding='utf-8', newline='') as handle:
        handle.write(text)
    state_file.write_text(plan.analysis.to_json())


compiler = os.environ['V5X_REAL_CXX']
args = sys.argv[1:]
# Compiler-specific target flags (clang needs the ARM sysroot spelled out; gcc's driver already knows it).
target_flags = json.loads(os.environ.get('V5X_EXTRA_CXX_FLAGS', '[]'))
source = next((a for a in args if a.endswith(('.cpp', '.cc', '.cxx'))), None)
if '-c' not in args or not source:
    os.execvp(compiler, [compiler, *args])
mark('cxx-start', source=source)
# Library-only PCHs are baked into the Builder checkpoint, so they must not depend on project headers or debug info.
library_prefix = os.environ.get('V5X_PCH_SOURCE')
DEBUG_FLAG = re.compile(r'-g(?:\d|gdb\d*)?')
if library_prefix is not None:
    args = [arg for arg in args if not DEBUG_FLAG.fullmatch(arg)] + ['-g0']
flags = []
skip = False
for arg in args:
    if skip:
        skip = False
        continue
    if arg in ('-o', '-MF', '-MT', '-MQ'):
        skip = True
    elif arg not in ('-c', source, '-MMD', '-MD', '-MP'):
        flags.append(arg)
if library_prefix is not None:
    prefix_text = library_prefix
    label = 'library headers'
    digest = hashlib.sha256((compiler + repr(flags) + repr(target_flags) + prefix_text + ('pch-instantiate-templates' if 'clang' in pathlib.Path(compiler).name else '')).encode())
else:
    header = pathlib.Path(os.environ['V5X_PCH_HEADER'])
    prefix_text = '#include "' + str(header) + '"\n'
    label = header.name
    digest = hashlib.sha256((compiler + repr(flags)).encode())
    # Include all project headers, including those outside include/, to invalidate cached PCHs.
    for path in sorted(pathlib.Path.cwd().rglob('*')):
        if path.is_file() and path.suffix in ('.h', '.hpp', '.hh', '.hxx', '.inc'):
            digest.update(str(path).encode())
            digest.update(path.read_bytes())
            if 'clang' in pathlib.Path(compiler).name:
                digest.update(str((path.stat().st_mtime_ns, path.stat().st_ino)).encode())
cache = pathlib.Path(os.environ.get('V5X_PCH_CACHE', '/home/builder/.cache/v5x-pch')) / digest.hexdigest()
cache.mkdir(parents=True, exist_ok=True)
with (cache / 'lock').open('w') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    prefix = cache / 'prefix.h'
    pch = cache / 'prefix.h.gch'
    mark('pch-lookup', hit=pch.exists(), key=digest.hexdigest()[:12])
    if not pch.exists():
        print('Precompiling ' + label, flush=True)
        prefix.write_text(prefix_text)
        # A cancelled build can kill this compile; publish the PCH only once it is complete.
        partial = cache / 'prefix.h.gch.partial'
        # Clang instantiates the PCH's pending templates up front; without this an empty translation unit still pays ~300 ms per compile.
        pch_flags = ['-Xclang', '-fpch-instantiate-templates'] if 'clang' in pathlib.Path(compiler).name else []
        subprocess.run([compiler, *target_flags, *flags, *pch_flags, '-x', 'c++-header', str(prefix), '-o', str(partial)], check=True)
        os.replace(partial, pch)
        mark('pch-built', key=digest.hexdigest()[:12])
# Per-function units (clang with the library PCH): an edit recompiles only the function it touched. Any file the
# splitter cannot prove equivalent falls through to the whole-file compile below. See unit_build.py.
if os.environ.get('V5X_UNITS') == '1' and library_prefix is not None and 'clang' in pathlib.Path(compiler).name:
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import unit_build
        output = args[args.index('-o') + 1] if '-o' in args else None
        if output is None:
            raise unit_build.Unsplittable('no output path')
        run_units(source, output, compiler, target_flags, flags, str(pch), pathlib.Path(os.environ.get('V5X_UNIT_CACHE', '/home/builder/.cache/v5x-units')), str(prefix))
        mark('units-done', source=source)
        sys.exit(0)
    except Exception as error:
        mark('units-fallback', source=source, reason=str(error)[:300])
        print(f'Compiling {source} whole: {str(error)[:300]}', file=sys.stderr, flush=True)
# Clang validates header metadata too. Uploads preserve unchanged headers, and
# the cache key includes metadata to invalidate headers restored to older contents.
extra = ['-include-pch', str(pch)] if 'clang' in pathlib.Path(compiler).name else ['-include', str(prefix), '-Werror=invalid-pch']
if TIMING_LOG:
    result = subprocess.run([compiler, *target_flags, *extra, *args])
    mark('cxx-end', source=source, code=result.returncode)
    sys.exit(result.returncode)
os.execvp(compiler, [compiler, *target_flags, *extra, *args])
