{
  "name": "@v5x/root",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --ui=tui",
    "lint": "bun run check:boundaries && turbo lint",
    "test": "bun run test:tooling && turbo test",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:tooling": "node --test scripts/tests/*.test.mjs",
    "format:check": "prettier --check \"apps/*/*/src/**/*.{ts,tsx}\" \"apps/*/*/tests/**/*.ts\" \"apps/*/*/e2e/**/*.{ts,mjs}\" \"apps/*/*/scripts/*.mjs\" \"packages/*/src/**/*.{ts,tsx}\" \"packages/backend/convex/**/*.ts\" \"packages/backend/tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*/*",
    "packages/*"
  ]
}
